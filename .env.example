# Wazy settings. Copy this file to .env and uncomment what you need. Every setting is optional:
# with no .env at all, Wazy runs on this computer only, with the rule-based reader and no WhatsApp.
# Real environment variables win over this file. A setting that is present but wrong stops Wazy from starting.
# Never commit .env: it holds secrets (it is git-ignored).

# Address to listen on: 127.0.0.1 is this computer only; 0.0.0.0 on a hosted server.
# WAZY_HOST=127.0.0.1

# Port, 1 to 65535. If empty, PORT is used (hosting platforms set it), otherwise 8765.
# WAZY_PORT=8765

# Time zone for reading times and for new people, e.g. Europe/Madrid. Must be a real zone name.
# WAZY_TZ=Europe/Madrid

# The SQLite database file. Created if missing.
# WAZY_DB=data/wazy.db

# Optional Claude Haiku title tidier. Must start with sk-ant-. The rules still decide every time.
# ANTHROPIC_API_KEY=

# The model the title tidier uses.
# WAZY_AI_MODEL=claude-haiku-4-5-20251001

# Minutes until the extra nudge after "Later", 1 to 1440. Empty: the next morning. For a live demo, try 1.
# WAZY_LATER_MINUTES=

# Code other browsers need once (/?k=CODE): 8+ letters, digits, - or _. Empty: generated once and kept.
# WAZY_ACCESS_CODE=

# Code to open the presenter view from another computer (/demo?admin=CODE): 12+ letters, digits, - or _.
# WAZY_ADMIN_CODE=

# The https address people reach this server at. Required with WhatsApp; also used for the QR code.
# WAZY_PUBLIC_URL=https://wazy.example.com

# WhatsApp through Twilio: set all three or none. Account SID: AC followed by 32 hex characters.
# TWILIO_ACCOUNT_SID=

# Twilio auth token: 32 hex characters. Used to send messages and to check that webhooks come from Twilio.
# TWILIO_AUTH_TOKEN=

# The WhatsApp sender, written as whatsapp:+ and the number's digits, e.g. whatsapp:+14155238886.
# TWILIO_WHATSAPP_FROM=

# Optional Content Template with Done / Later buttons: HX followed by 32 hex characters.
# TWILIO_CONTENT_SID=
