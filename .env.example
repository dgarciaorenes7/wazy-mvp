# Wazy MVP settings. Copy this file to .env to use it. Every line is optional:
# with no .env at all, the MVP runs on this computer with the rule-based reader.
# Never commit a real key: .env is git-ignored.

# Optional. If set, Claude Haiku tidies the wording of each commitment (the rules still decide the time).
# ANTHROPIC_API_KEY=

# Empty: "Later" nudges once more the next morning at 10:00. For a live demo, set a number of minutes, e.g. 1.
# WAZY_LATER_MINUTES=

# Optional fixed access code for phones (at least 8 characters). Generated and kept if empty.
# WAZY_ACCESS_CODE=

# WAZY_PORT=8765
# WAZY_DB=data/wazy.db
